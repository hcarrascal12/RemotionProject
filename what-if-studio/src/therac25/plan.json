  "science": [
    {
      "claim": "Therac-25 overdoses, 1985-1987: six known accidents, several deaths.",
      "source": "Leveson & Turner, 'An Investigation of the Therac-25 Accidents', IEEE Computer 26(7), 1993."
    },
    {
      "claim": "Fast editing of the treatment mode (X to E) within about 8 seconds triggered a race condition: the screen showed the corrected entry while the machine was set up wrongly.",
      "source": "Leveson & Turner 1993, Tyler (East Texas Cancer Center) accidents, 1986."
    },
    {
      "claim": "The Therac-25 dropped the hardware interlocks of earlier models and relied on software for safety.",
      "source": "Leveson & Turner 1993, section 'Background'."
    },
    {
      "claim": "The console showed 'MALFUNCTION 54' and a dose readout suggesting underdose; the operator pressed P to proceed again.",
      "source": "Leveson & Turner 1993, Tyler accident of March 1986."
    },
    {
      "claim": "Estimated doses of 16,500-25,000 rads against a prescribed dose of about 180-200 rads: roughly 100 times the intended dose.",
      "source": "Leveson & Turner 1993, estimates for the Tyler accidents."
    }
  ],
