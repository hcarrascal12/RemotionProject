  "science": [
    {
      "claim": "\"Un día normal, sin tormenta\": the FCC called it a \"sunny day\" outage, one not caused by weather or a disaster.",
      "source": "IEEE Spectrum (Oct 2014), quoting FCC Chairman Wheeler."
    },
    {
      "claim": "Late on 9 April 2014, for about six hours, 911 calls from parts of seven states failed to reach 81 call centres; about 6,600 calls were not completed.",
      "source": "FCC report (Oct 2014) via Urgent Comm, Threatpost; FCC settlement (2015) via EMS1, Benton."
    },
    {
      "claim": "Calls from Washington state were stuck at a routing centre in Englewood, Colorado.",
      "source": "AP, \"Report: Washington 911 calls got stuck in Colorado\" (Apr 2014), via phys.org and Star Tribune."
    },
    {
      "claim": "The cause: the software gave each call a number from a counter capped at 40 million; when it hit the cap it stopped routing calls. An FCC official called the cap \"arbitrary\".",
      "source": "FCC report via IEEE Spectrum, HotHardware, Threatpost, the SystemSafety list (Oct 2014)."
    },
    {
      "claim": "The hand-over: WhatsApp went down worldwide on 4 October 2021 (Fallo #04).",
      "source": "Engineering at Meta, 5 Oct 2021."
    }
  ],
