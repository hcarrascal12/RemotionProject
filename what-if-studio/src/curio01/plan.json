  "science": [
    {
      "claim": "Late on 9 April 2014 a call-routing facility in Englewood, Colorado stopped delivering 911 calls to 81 call centres (PSAPs) in several states, for about six hours.",
      "source": "FCC Public Safety and Homeland Security Bureau report (Oct 2014), via Urgent Comm and Threatpost."
    },
    {
      "claim": "About 6,600 911 calls were not completed.",
      "source": "FCC settlement with CenturyLink and Intrado (2015), via EMS1 and Benton."
    },
    {
      "claim": "The cause was a preventable software coding error in Intrado's system.",
      "source": "FCC report, via HotHardware."
    },
    {
      "claim": "NOT USED (unconfirmed): that the error was a call counter reaching its maximum. The code on screen is labelled illustrative and implies no cause."
    },
    {
      "claim": "The advice (keep the direct numbers of the police and fire service) is general prevention advice, not a fact."
    },
    {
      "claim": "The hand-over: WhatsApp, Instagram and Facebook went down at the same time on 4 October 2021 (Fallo #04).",
      "source": "Engineering at Meta, 5 Oct 2021."
    }
  ],
