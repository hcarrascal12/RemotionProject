  "science": [
    {
      "claim": "On 19 July 2024 a faulty Falcon content update (Channel File 291) crashed Windows hosts. Published 04:09 UTC, reverted 05:27 UTC (78 minutes).",
      "source": "CrowdStrike, Statement on Falcon Content Update for Windows Hosts (2024); Channel File 291 Incident Root Cause Analysis, 6 Aug 2024."
    },
    {
      "claim": "Root cause: the IPC Template Type defined 21 input fields but the sensor integration code supplied only 20 values; the Content Interpreter read the 21st (out-of-bounds read).",
      "source": "CrowdStrike, Channel File 291 Incident Root Cause Analysis, 6 Aug 2024."
    },
    {
      "claim": "About 8.5 million Windows devices were affected (Microsoft estimate, under 1% of Windows machines). Not a cyberattack; the bug was judged not exploitable.",
      "source": "Microsoft estimate as reported by SecurityWeek (July 2024); CrowdStrike RCA."
    },
    {
      "claim": "Remediation was manual for many machines: boot into Safe Mode or Recovery and delete the faulty file; machines with disk encryption could ask for a recovery key. Some recovered after repeated reboots.",
      "source": "CrowdStrike remediation guidance; Microsoft KB5042429 recovery tool."
    },
    {
      "claim": "Simplification: the red key ENVIAR is a symbol for the company pushing the update (no such physical key existed). Hospital/airport/bank scenes are illustrative of the documented disruption."
    }
  ],
