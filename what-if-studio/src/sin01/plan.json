  "science": [
    {
      "claim": "On 4 January 2012 an anonymous image appeared on 4chan: \"Hello. We are looking for highly intelligent individuals. To find them, we have devised a test.\" Signed 3301.",
      "source": "Wikipedia \"Cicada 3301\"; The Why Files, \"Solving Cicada 3301\" (2023). POR VERIFICAR antes de publicar."
    },
    {
      "claim": "The image hid a message (steganography) that led to a book cipher, geographic coordinates and posters with QR codes in several cities.",
      "source": "Wikipedia \"Cicada 3301\"; Rolling Stone, \"Cicada: Solving the Web's Deepest Mystery\" (2014). POR VERIFICAR."
    },
    {
      "claim": "Three rounds of puzzles: January 2012, January 2013 and January 2014; nobody has confirmed who was behind them or why.",
      "source": "Wikipedia \"Cicada 3301\". POR VERIFICAR: estado actual (algunos puzzles posteriores se consideran falsos)."
    }
  ],
