  "science": [
    {
      "claim": "On 28 March 2011 a 75-year-old woman in Georgia, digging for scrap copper, cut a fibre-optic cable with a spade; most of Armenia (and parts of Georgia) lost internet access for hours.",
      "source": "NPR (7 Apr 2011), IEEE Spectrum, Foreign Policy (6 Apr 2011), The Moscow Times (10 Apr 2011), iTnews."
    },
    {
      "claim": "How long: reports range from a few hours (Armenian providers: about half their customers, for a few hours) to up to 12 hours, so the film says \"durante horas\" and \"casi toda Armenia\".",
      "source": "NPR; The Moscow Times; IEEE Spectrum."
    },
    {
      "claim": "She was arrested and released because of her age; local media called her the \"spade hacker\".",
      "source": "The World / PRI; NPR."
    },
    {
      "claim": "The hand-over: Fallo #04, 4 October 2021, WhatsApp, Instagram and Facebook down worldwide for about six hours.",
      "source": "Engineering at Meta, 5 Oct 2021."
    }
  ],
