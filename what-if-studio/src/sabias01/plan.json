      "id": "A1",
      "src": [
        0.07,
        5.75
      ],
      "words": "¿SABÍAS QUE | UNA ABUELA | DE 75* AÑOS | DEJÓ SIN INTERNET! | A CASI^ TODA ARMENIA*^ | CON UNA PALA!"
    },
    {
      "id": "A2",
      "src": [
        6.24,
        11.39
      ],
      "words": "MARZO DE 2011* | EN GEORGIA^ | BUSCABA^ | COBRE* PARA VENDER | COMO CHATARRA"
    },
    {
      "id": "A3",
      "src": [
        11.81,
        15.73
      ],
      "words": "CAVÓ Y CAVÓ^ | Y EN VEZ DE COBRE^ | CORTÓ UN CABLE! | DE FIBRA ÓPTICA*"
    },
    {
      "id": "A4",
      "src": [
        16.05,
        21.89
      ],
      "words": "ESE CABLE | LLEVABA INTERNET A ARMENIA*^ | EL PAÍS SE QUEDÓ | DESCONECTADO! | DURANTE HORAS^ | Y PARTE DE GEORGIA | TAMBIÉN"
    },
    {
      "id": "A5",
      "src": [
        22.26,
        27.48
      ],
      "words": "LA DETUVIERON! | Y LA^ SOLTARON | POR SU EDAD*^ | LA PRENSA LA LLAMÓ^ | LA HACKER DE LA PALA!"
