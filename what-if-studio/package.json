{
  "name": "what-if-studio",
  "version": "1.0.0",
  "private": true,
  "description": "What If animation studio: one topic line in, a finished 15-25 s episode out. Every frame is SVG drawn in code (Remotion).",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3430",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.0.0",
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/google-fonts": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@remotion/three": "4.0.530",
    "@types/three": "0.170.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.530",
    "three": "0.170.0",
    "use-sync-external-store": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.8.2"
  }
}
